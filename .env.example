# MongoDB Atlas connection string. Keep credentials out of this file.
MONGODB_URI=mongodb://<username>:<password>@<hosts>/adybabacrm?<options>
MONGODB_DB=adybabacrm
NEXT_PUBLIC_SITE_URL=https://your-domain.example
AUTH_SECRET=replace-with-a-long-random-secret

# Google Drive Backup
BACKUP_ENCRYPTION_KEY="<64_character_hex_string_32_bytes>"
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=30
